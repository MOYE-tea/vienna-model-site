PORT=3000

# iCloud calendar sync (used when a booking is accepted in the admin)
# 1. In the Calendar app (or icloud.com/calendar), create a NEW calendar — this
#    integration only ever writes to this one calendar, never your existing ones.
# 2. Generate an app-specific password at appleid.apple.com (Sign-In and Security
#    -> App-Specific Passwords) — do NOT use your real Apple ID password here.
ICLOUD_APPLE_ID=_待填_
ICLOUD_APP_PASSWORD=_待填_
ICLOUD_CALENDAR_NAME=Vienna 拍攝
